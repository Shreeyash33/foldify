# Copy to .env — never commit .env itself.
#
# No inline env vars in npm scripts: `PORT=4000 tsx src/server.ts` does not work
# in cmd.exe or PowerShell. Everything is read from this file via dotenv.

PORT=4000
NODE_ENV=development

# Must be the exact frontend origin. CORS with credentials rejects a wildcard.
FRONTEND_ORIGIN=http://localhost:3000

SESSION_COOKIE_NAME=foldify_sid

# Relative to backend/. Resolved with path.join, so forward slashes are fine on Windows.
DB_PATH=./data/foldify.db

# Seed admin account. Change the password before deploying anywhere real.
SEED_ADMIN_EMAIL=admin@foldify.local
SEED_ADMIN_PASSWORD=foldify-admin
