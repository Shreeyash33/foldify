# Copy to .env — never commit .env itself.
#
# No inline env vars in npm scripts: `PORT=4000 tsx src/server.ts` does not work
# in cmd.exe or PowerShell. Everything is read from this file via dotenv.

PORT=4000
NODE_ENV=development

# Must be the exact frontend origin(s). CORS with credentials rejects a wildcard.
# One origin: "http://localhost:3000". Several — e.g. a second machine on the
# same LAN — use a comma-separated list: "http://localhost:3000,http://192.168.1.50:3000".
FRONTEND_ORIGIN=http://localhost:3000

# Single canonical frontend URL used for provider redirects (Khalti return_url /
# website_url). Defaults to the first entry of FRONTEND_ORIGIN; set it explicitly
# when the CORS list has many origins but redirects must go to one.
FRONTEND_URL=http://localhost:3000

SESSION_COOKIE_NAME=foldify_sid

# Relative to backend/. Resolved with path.join, so forward slashes are fine on Windows.
DB_PATH=./data/foldify.db

# Seed admin account. Change the password before deploying anywhere real.
SEED_ADMIN_EMAIL=admin@foldify.local
SEED_ADMIN_PASSWORD=foldify-admin

# Khalti payment gateway (sandbox). Get your live_secret_key from https://dev.khalti.com.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com

# How long delivery takes after an order is placed (hours) — used in the
# order-confirmation SMS delivery estimate.
DELIVERY_ESTIMATE_HOURS=72

# SMS provider for order notifications. When SMS_API_URL is blank the backend
# logs the message instead of sending it (simulated mode, like Khalti).
# Point SMS_API_URL at any JSON endpoint that accepts `{ phone, message }`.
SMS_API_URL=
SMS_API_KEY=
