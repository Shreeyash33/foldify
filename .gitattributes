# Normalise line endings across three Windows machines.
# Without this, CRLF/LF churn makes every diff look like a full rewrite.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary
*.node binary
