# Copy to .env.local -- never commit .env.local itself.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time, so
# changing them requires restarting the dev server.

# The backend's base URL. Defaults to http://localhost:4000 when unset.
# Must match the backend's FRONTEND_ORIGIN so the CORS-with-credentials check
# passes. When sharing over the LAN, use the machine's IP instead:
# e.g. NEXT_PUBLIC_API_URL=http://192.168.55.123:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Comma-separated hostnames allowed to hot-reload against the Next dev server.
# Useful when a second machine on the LAN opens the site via the host's IP.
# Use bare hostnames -- no scheme, no port, no trailing slash -- because
# next.config.ts strips those before passing them to allowedDevOrigins.
#   e.g. "192.168.55.123,localhost"
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=

# Mock mode. OFF by default: unset or any value other than the literal "true"
# means api-client.ts calls the real API, which is right since `npm run dev`
# starts both apps. Set it to the literal "true" only when you want to work
# with the backend stopped -- api-client.ts then serves lib/mock-data.ts.
NEXT_PUBLIC_USE_MOCK=
